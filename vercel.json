{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/demo/unofficial-clothing",
      "destination": "/demo/unofficial-clothing/index.html"
    },
    {
      "source": "/demo/unofficial-clothing/",
      "destination": "/demo/unofficial-clothing/index.html"
    },
    {
      "source": "/demo/:client",
      "destination": "/demo/:client/index.html"
    },
    {
      "source": "/demo/:client/",
      "destination": "/demo/:client/index.html"
    }
  ]
}
