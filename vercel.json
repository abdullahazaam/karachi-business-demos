{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/demo/unofficial-clothing/",
      "permanent": false
    },
    {
      "source": "/demo/:client",
      "destination": "/demo/:client/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/demo/:client/",
      "destination": "/demo/:client/index.html"
    }
  ]
}
